# Server
PORT=8787
SOFRA_DATA_DIR=./data
# Public URL used in invite links when behind a proxy (optional)
SOFRA_PUBLIC_URL=

# AI provider: anthropic | openai | openai-compatible | none
SOFRA_AI_PROVIDER=anthropic
SOFRA_AI_MODEL=claude-fable-5-2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For openai-compatible (Ollama, LM Studio, vLLM, OpenRouter...)
SOFRA_AI_BASE_URL=http://localhost:11434/v1
SOFRA_AI_API_KEY=
