# Copy to .env and fill in what you need. Every line is optional.

# Server. In Docker the data directory is /data (the volume); leave these unset there.
# PORT=8787
# SOFRA_DATA_DIR=./data

# AI provider: anthropic | openai | openai-compatible | none.
# When unset, it is picked from whichever key or base URL below is present.
# SOFRA_AI_PROVIDER=
# SOFRA_AI_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenAI-compatible endpoints (Ollama, LM Studio, vLLM, OpenRouter...)
# SOFRA_AI_BASE_URL=http://host.docker.internal:11434/v1
# SOFRA_AI_API_KEY=
