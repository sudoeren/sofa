{
  "name": "sofra",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, self-hosted shared spaces where a group asks an AI to build the small tools it needs.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @sofra/server --filter @sofra/web dev",
    "build": "pnpm --filter @sofra/web build && pnpm --filter @sofra/server build",
    "start": "node apps/server/dist/index.js",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
