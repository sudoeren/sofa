{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": ["**", "!**/dist", "!**/data", "!**/node_modules"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/runtime/sdk.js"],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "off",
            "useOptionalChain": "off"
          },
          "correctness": {
            "noInnerDeclarations": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "useTemplate": "off"
          },
          "suspicious": {
            "noRedundantUseStrict": "off",
            "noPrototypeBuiltins": "off",
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/testing.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnsafeOptionalChaining": "off",
            "noComponentHookFactories": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off",
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.html", "**/*.svg"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
